# The owner provisions only the Spotify app's client_id here (the shared app
# identity). It is NOT secret-sensitive but is kept out of git like the rest of
# secrets.py. End users never see it: WiFi and the Spotify refresh token are
# entered on-device during self-serve setup and saved to /config.json on flash.
#
# Create an app at https://developer.spotify.com/dashboard, use PKCE (no client
# secret needed), and register the GitHub Pages helper URL as a Redirect URI,
# e.g. https://<you>.github.io/PrestoDeck/cb/
SPOTIFY_CLIENT_ID = "your_spotify_client_id"

# Optional: pre-seed WiFi to skip the on-device WiFi step (otherwise leave out).
# WIFI_SSID = "WIFI_SSID"
# WIFI_PASSWORD = "WIFI_PASSWORD"

# --- Legacy (still supported) ---------------------------------------------
# A full pre-generated credentials dict from `bash adhoc/generate_token.sh`
# still boots without the on-device flow:
# SPOTIFY_CREDENTIALS = {
#     "refresh_token": "...",
#     "client_id": "...",
#     "client_secret": "...",
#     "device_id": None,
# }
